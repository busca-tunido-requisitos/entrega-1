@startuml
title CU-DG-01 · Casos de uso
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam titleFontSize 22
skinparam titleFontColor #16324F
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #64748B
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 12
skinparam roundcorner 14
skinparam nodesep 65
skinparam ranksep 65
skinparam padding 6
skinparam classBackgroundColor #F1F5F9
skinparam classBorderColor #94A3B8
skinparam classHeaderBackgroundColor #DBEAFE
skinparam classFontColor #16324F
skinparam stateBackgroundColor #EFF6FF
skinparam stateBorderColor #7C9CBF
skinparam stateFontColor #16324F
skinparam usecaseBackgroundColor #EFF6FF
skinparam usecaseBorderColor #7C9CBF
skinparam usecaseFontColor #16324F
skinparam actorBorderColor #475569
skinparam actorFontColor #16324F
skinparam rectangleBorderColor #CBD5E1
skinparam rectangleFontColor #16324F
left to right direction
actor Estudiante
actor "Dueño de pensión" as Dueno
rectangle "BuscaTuNido" {
 usecase "CU-01\nBuscar alojamiento" as CU01
 usecase "CU-02\nSolicitar reserva" as CU02
 usecase "CU-04\nObtener comprobante" as CU04
 usecase "CU-05\nCoordinar llegada" as CU05
 usecase "CU-03\nResolver solicitud" as CU03
}
actor "Servicio Push\n(FCM)" as Push <<externo>>
actor "Servicio de firma QR" as QR <<externo>>
Estudiante --> CU01
Estudiante --> CU02
Estudiante --> CU04
Estudiante --> CU05
Dueno --> CU05
Dueno --> CU03
CU02 --> Push
CU03 --> Push
CU04 --> QR
@enduml

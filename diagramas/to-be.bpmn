<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_TO_BE"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_TO_BE">
    <bpmn:participant id="Participant_TO_BE" name="Proceso TO-BE: Búsqueda y Reserva" processRef="Process_TO_BE" />
  </bpmn:collaboration>

  <bpmn:process id="Process_TO_BE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TO_BE">
      <bpmn:lane id="Lane_Usuario" name="Usuario (Foráneo)">
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuscarPension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CargarCatalogo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerOpciones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirConfirmacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SinCupo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReservaCoordinada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dueno" name="Dueño (Arrendador)">
        <bpmn:flowNodeRef>Task_NotificacionPush</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Disponible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RechazarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActualizarEstado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AprobarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BloquearFechas</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Inicio" name="Inicio">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_BuscarPension" name="Buscar pensión y aplicar filtros">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_CargarCatalogo" name="Consultar y cargar catálogo en tiempo real">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_EnviarSolicitud" name="Enviar solicitud de reserva">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_NotificacionPush" name="Generar notificación push de solicitud">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_RevisarSolicitud" name="Revisar solicitud y perfil en la app">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Disponible" name="¿Disponible y acepta?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Si</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_RechazarSolicitud" name="Rechazar solicitud">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ActualizarEstado" name="Actualizar estado y disparar alerta">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_AprobarSolicitud" name="Aprobar solicitud de reserva">
      <bpmn:incoming>Flow_Si</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_BloquearFechas" name="Bloquear fechas y emitir ficha de confirmación">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_VerOpciones" name="Ver opciones alternativas sugeridas">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_SinCupo" name="Fin: Sin cupo">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_RecibirConfirmacion" name="Recibir confirmación y coordinar llegada por chat">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_ReservaCoordinada" name="Fin: Reserva coordinada">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Inicio" targetRef="Task_BuscarPension" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_BuscarPension" targetRef="Task_CargarCatalogo" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CargarCatalogo" targetRef="Task_EnviarSolicitud" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_EnviarSolicitud" targetRef="Task_NotificacionPush" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_NotificacionPush" targetRef="Task_RevisarSolicitud" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RevisarSolicitud" targetRef="Gateway_Disponible" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Disponible" targetRef="Task_RechazarSolicitud" />
    <bpmn:sequenceFlow id="Flow_Si" name="Sí" sourceRef="Gateway_Disponible" targetRef="Task_AprobarSolicitud" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_RechazarSolicitud" targetRef="Task_ActualizarEstado" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ActualizarEstado" targetRef="Task_VerOpciones" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AprobarSolicitud" targetRef="Task_BloquearFechas" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_BloquearFechas" targetRef="Task_RecibirConfirmacion" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_VerOpciones" targetRef="EndEvent_SinCupo" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RecibirConfirmacion" targetRef="EndEvent_ReservaCoordinada" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_TO_BE">
    <bpmndi:BPMNPlane id="BPMNPlane_TO_BE" bpmnElement="Collaboration_TO_BE">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_TO_BE" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1440" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Usuario" bpmnElement="Lane_Usuario" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1410" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Dueno" bpmnElement="Lane_Dueno" isHorizontal="true">
        <dc:Bounds x="190" y="340" width="1410" height="260" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

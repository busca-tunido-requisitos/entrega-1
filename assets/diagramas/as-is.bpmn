<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_AS_IS"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">
  <bpmn:collaboration id="Collaboration_AS_IS">
    <bpmn:participant id="Participant_AS_IS" name="Búsqueda y Arriendo Tradicional de Pensiones Universitarias (AS-IS)" processRef="Process_AS_IS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AS_IS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AS_IS">
      <bpmn:lane id="Lane_Estudiante" name="Estudiante Universitario">
        <bpmn:flowNodeRef>Start_Estudiante</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_AS_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_AS_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_AS_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_AS_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Arrendado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dueno" name="Dueño de Pensión">
        <bpmn:flowNodeRef>ACT_AS_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cupo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SinCupo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="Start_Estudiante" name="Necesita pensión" />
    <bpmn:manualTask id="ACT_AS_01" name="ACT-AS-01: Buscar avisos informales en postes y redes sociales" />
    <bpmn:manualTask id="ACT_AS_02" name="ACT-AS-02: Llamar al dueño para consultar disponibilidad y precio" />
    <bpmn:manualTask id="ACT_AS_03" name="ACT-AS-03: Revisar disponibilidad en cuaderno manual" />
    <bpmn:exclusiveGateway id="Gateway_Cupo" name="¿Hay pieza disponible?" />
    <bpmn:manualTask id="ACT_AS_04" name="ACT-AS-04: Realizar visita presencial para conocer inmueble y reglas" />
    <bpmn:manualTask id="ACT_AS_05" name="ACT-AS-05: Pago de mes/garantía y entrega manual de llaves" />
    <bpmn:endEvent id="End_Arrendado" name="Habitación arrendada" />
    <bpmn:endEvent id="End_SinCupo" name="Fin sin arriendo" />
    
    <bpmn:sequenceFlow id="f1" sourceRef="Start_Estudiante" targetRef="ACT_AS_01" />
    <bpmn:sequenceFlow id="f2" sourceRef="ACT_AS_01" targetRef="ACT_AS_02" />
    <bpmn:sequenceFlow id="f3" sourceRef="ACT_AS_02" targetRef="ACT_AS_03" />
    <bpmn:sequenceFlow id="f4" sourceRef="ACT_AS_03" targetRef="Gateway_Cupo" />
    <bpmn:sequenceFlow id="fNo" name="No" sourceRef="Gateway_Cupo" targetRef="End_SinCupo" />
    <bpmn:sequenceFlow id="fSi" name="Sí" sourceRef="Gateway_Cupo" targetRef="ACT_AS_04" />
    <bpmn:sequenceFlow id="f5" sourceRef="ACT_AS_04" targetRef="ACT_AS_05" />
    <bpmn:sequenceFlow id="f6" sourceRef="ACT_AS_05" targetRef="End_Arrendado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_AS_IS">
      <bpmndi:BPMNShape id="Participant_AS_IS_di" bpmnElement="Participant_AS_IS" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1120" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Estudiante_di" bpmnElement="Lane_Estudiante" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1090" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dueno_di" bpmnElement="Lane_Dueno" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="1090" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Estudiante_di" bpmnElement="Start_Estudiante">
        <dc:Bounds x="240" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="216" y="215" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_AS_01_di" bpmnElement="ACT_AS_01">
        <dc:Bounds x="330" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_AS_02_di" bpmnElement="ACT_AS_02">
        <dc:Bounds x="500" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_AS_03_di" bpmnElement="ACT_AS_03">
        <dc:Bounds x="500" y="370" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Cupo_di" bpmnElement="Gateway_Cupo" isMarkerVisible="true">
        <dc:Bounds x="670" y="385" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="442" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_SinCupo_di" bpmnElement="End_SinCupo">
        <dc:Bounds x="780" y="472" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="760" y="515" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_AS_04_di" bpmnElement="ACT_AS_04">
        <dc:Bounds x="840" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_AS_05_di" bpmnElement="ACT_AS_05">
        <dc:Bounds x="1010" y="150" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Arrendado_di" bpmnElement="End_Arrendado">
        <dc:Bounds x="1180" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1170" y="215" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="276" y="190" />
        <di:waypoint x="330" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="450" y="190" />
        <di:waypoint x="500" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="560" y="230" />
        <di:waypoint x="560" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="620" y="410" />
        <di:waypoint x="670" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fNo_di" bpmnElement="fNo">
        <di:waypoint x="695" y="435" />
        <di:waypoint x="695" y="490" />
        <di:waypoint x="780" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="702" y="455" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fSi_di" bpmnElement="fSi">
        <di:waypoint x="720" y="410" />
        <di:waypoint x="780" y="410" />
        <di:waypoint x="780" y="190" />
        <di:waypoint x="840" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="739" y="392" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="960" y="190" />
        <di:waypoint x="1010" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="1130" y="190" />
        <di:waypoint x="1180" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_AS_IS"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">
  <bpmn:collaboration id="Collaboration_AS_IS">
    <bpmn:participant id="Participant_AS_IS" name="Búsqueda y Arriendo Tradicional de Pensiones Universitarias (AS-IS)" processRef="Process_AS_IS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AS_IS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AS_IS">
      <bpmn:lane id="Lane_Estudiante" name="Estudiante Universitario">
        <bpmn:flowNodeRef>Start_Estudiante</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_AS_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_AS_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_AS_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_AS_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Arrendado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SinCupo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dueno" name="Dueño de Pensión">
        <bpmn:flowNodeRef>ACT_AS_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cupo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="Start_Estudiante" name="Necesita pensión" />
    <bpmn:manualTask id="ACT_AS_01" name="ACT-AS-01: Buscar avisos informales en postes y redes sociales" />
    <bpmn:manualTask id="ACT_AS_02" name="ACT-AS-02: Llamar al dueño para consultar disponibilidad y precio" />
    <bpmn:manualTask id="ACT_AS_03" name="ACT-AS-03: Revisar disponibilidad en cuaderno manual" />
    <bpmn:exclusiveGateway id="Gateway_Cupo" name="¿Hay pieza disponible?" />
    <bpmn:manualTask id="ACT_AS_04" name="ACT-AS-04: Realizar visita presencial para conocer inmueble y reglas" />
    <bpmn:manualTask id="ACT_AS_05" name="ACT-AS-05: Pago de mes/garantía y entrega manual de llaves" />
    <bpmn:endEvent id="End_Arrendado" name="Habitación arrendada" />
    <bpmn:endEvent id="End_SinCupo" name="Fin sin arriendo" />
    
    <bpmn:sequenceFlow id="f1" sourceRef="Start_Estudiante" targetRef="ACT_AS_01" />
    <bpmn:sequenceFlow id="f2" sourceRef="ACT_AS_01" targetRef="ACT_AS_02" />
    <bpmn:sequenceFlow id="f3" sourceRef="ACT_AS_02" targetRef="ACT_AS_03" />
    <bpmn:sequenceFlow id="f4" sourceRef="ACT_AS_03" targetRef="Gateway_Cupo" />
    <bpmn:sequenceFlow id="fNo" name="No" sourceRef="Gateway_Cupo" targetRef="End_SinCupo" />
    <bpmn:sequenceFlow id="fSi" name="Sí" sourceRef="Gateway_Cupo" targetRef="ACT_AS_04" />
    <bpmn:sequenceFlow id="f5" sourceRef="ACT_AS_04" targetRef="ACT_AS_05" />
    <bpmn:sequenceFlow id="f6" sourceRef="ACT_AS_05" targetRef="End_Arrendado" />
  </bpmn:process>
</bpmn:definitions>
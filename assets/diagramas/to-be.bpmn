<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_TO_BE"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">
  <bpmn:collaboration id="Collaboration_TO_BE">
    <bpmn:participant id="Participant_TO_BE" name="Proceso TO-BE: Búsqueda y Reserva" processRef="Process_TO_BE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TO_BE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TO_BE">
      <bpmn:lane id="Lane_Usuario" name="Usuario (Foráneo)">
        <bpmn:flowNodeRef>Start_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SinCupo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reserva</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dueno" name="Dueño (Arrendador)">
        <bpmn:flowNodeRef>ACT_TOBE_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_TOBE_10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="Start_TOBE" name="Inicio" />
    <bpmn:userTask id="ACT_TOBE_01" name="Buscar pensión y aplicar filtros" />
    <bpmn:serviceTask id="ACT_TOBE_02" name="Consultar y cargar catálogo en tiempo real" />
    <bpmn:userTask id="ACT_TOBE_03" name="Enviar solicitud de reserva" />
    
    <bpmn:serviceTask id="ACT_TOBE_04" name="Generar notificación push de solicitud" />
    <bpmn:userTask id="ACT_TOBE_05" name="Revisar solicitud y perfil en la app" />
    <bpmn:exclusiveGateway id="Gateway_Decision" name="¿Disponible y acepta?" />
    
    <bpmn:userTask id="ACT_TOBE_06" name="Rechazar solicitud" />
    <bpmn:serviceTask id="ACT_TOBE_07" name="Actualizar estado y disparar alerta" />
    <bpmn:userTask id="ACT_TOBE_08" name="Ver opciones alternativas sugeridas" />
    <bpmn:endEvent id="End_SinCupo" name="Fin: Sin cupo" />
    
    <bpmn:userTask id="ACT_TOBE_09" name="Aprobar solicitud de reserva" />
    <bpmn:serviceTask id="ACT_TOBE_10" name="Bloquear fechas y emitir ficha de confirmación" />
    <bpmn:userTask id="ACT_TOBE_11" name="Recibir confirmación y coordinar llegada por chat" />
    <bpmn:endEvent id="End_Reserva" name="Fin: Reserva coordinada" />
    
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_TOBE" targetRef="ACT_TOBE_01" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ACT_TOBE_01" targetRef="ACT_TOBE_02" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ACT_TOBE_02" targetRef="ACT_TOBE_03" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ACT_TOBE_03" targetRef="ACT_TOBE_04" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="ACT_TOBE_04" targetRef="ACT_TOBE_05" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="ACT_TOBE_05" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Decision" targetRef="ACT_TOBE_06" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ACT_TOBE_06" targetRef="ACT_TOBE_07" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ACT_TOBE_07" targetRef="ACT_TOBE_08" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="ACT_TOBE_08" targetRef="End_SinCupo" />
    <bpmn:sequenceFlow id="Flow_Si" name="Si" sourceRef="Gateway_Decision" targetRef="ACT_TOBE_09" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="ACT_TOBE_09" targetRef="ACT_TOBE_10" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ACT_TOBE_10" targetRef="ACT_TOBE_11" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ACT_TOBE_11" targetRef="End_Reserva" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_TO_BE">
      <bpmndi:BPMNShape id="Participant_TO_BE_di" bpmnElement="Participant_TO_BE" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1580" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Usuario_di" bpmnElement="Lane_Usuario" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1550" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dueno_di" bpmnElement="Lane_Dueno" isHorizontal="true">
        <dc:Bounds x="50" y="280" width="1550" height="260" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Start_TOBE_di" bpmnElement="Start_TOBE">
        <dc:Bounds x="130" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="175" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_TOBE_01_di" bpmnElement="ACT_TOBE_01">

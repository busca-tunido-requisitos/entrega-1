      <bpmndi:BPMNShape id="ACT_TOBE_03_di" bpmnElement="ACT_TOBE_03">
        <dc:Bounds x="560" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="ACT_TOBE_04_di" bpmnElement="ACT_TOBE_04">
        <dc:Bounds x="560" y="370" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_TOBE_05_di" bpmnElement="ACT_TOBE_05">
        <dc:Bounds x="730" y="370" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="900" y="385" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="893" y="442" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="ACT_TOBE_06_di" bpmnElement="ACT_TOBE_06">
        <dc:Bounds x="980" y="295" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_TOBE_07_di" bpmnElement="ACT_TOBE_07">
        <dc:Bounds x="1140" y="295" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_TOBE_08_di" bpmnElement="ACT_TOBE_08">
        <dc:Bounds x="1350" y="45" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_SinCupo_di" bpmnElement="End_SinCupo">
        <dc:Bounds x="1520" y="67" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1507" y="110" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="ACT_TOBE_09_di" bpmnElement="ACT_TOBE_09">
        <dc:Bounds x="980" y="445" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_TOBE_10_di" bpmnElement="ACT_TOBE_10">
        <dc:Bounds x="1140" y="445" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACT_TOBE_11_di" bpmnElement="ACT_TOBE_11">
        <dc:Bounds x="1350" y="175" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Reserva_di" bpmnElement="End_Reserva">
        <dc:Bounds x="1520" y="197" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1506" y="240" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="166" y="150" />
        <di:waypoint x="210" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="150" />
        <di:waypoint x="380" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="520" y="150" />
        <di:waypoint x="560" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="625" y="190" />
        <di:waypoint x="625" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">

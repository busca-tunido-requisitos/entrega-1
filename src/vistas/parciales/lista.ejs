<% if (sinCoincidencias) { %>
<div class="vacio" role="status">
  <h2>No se encontraron habitaciones disponibles con ese criterio</h2>
  <p>
    Sugerencias: amplía el radio de búsqueda geográfica o flexibiliza las normas
    seleccionadas.
  </p>
</div>
<% } else { %>
<ul class="tarjetas">
  <% resultados.forEach(function (pension) { %>
  <li class="tarjeta">
    <div class="tarjeta-cabecera">
      <h2><%= pension.nombreComercial %></h2>
      <span class="chip"><%= formatearDistancia(pension.distanciaMetros) %></span>
    </div>
    <p class="direccion"><%= pension.direccion %>, <%= pension.comuna %></p>
    <p class="precio">Desde <%= formatearPrecio(pension.precioDesde) %> al mes</p>
    <p class="detalle">
      <%= pension.habitacionesDisponibles %> habitación(es) disponible(s) en el
      rango de precio
    </p>
    <ul class="normas">
      <li><%= pension.permiteVisitas ? 'Permite visitas' : 'No permite visitas' %></li>
      <li><%= pension.permiteMascotas ? 'Permite mascotas' : 'No permite mascotas' %></li>
      <li>
        <%= pension.horaToqueQueda ? 'Toque de queda ' + pension.horaToqueQueda : 'Sin toque de queda' %>
      </li>
    </ul>
    <p class="servicios"><%= pension.serviciosIncluidos %></p>

    <ul class="habitaciones">
      <% pension.habitacionesResumidas.forEach(function (habitacion) { %>
      <li class="habitacion">
        <div class="habitacion-datos">
          <strong><%= habitacion.identificadorHabitacion %></strong>
          <span><%= habitacion.tipoCama %></span>
          <span><%= habitacion.tieneBanoPrivado ? 'Baño privado' : 'Baño compartido' %></span>
          <span class="precio-habitacion"><%= formatearPrecio(habitacion.precioMensual) %></span>
        </div>
        <a
          class="boton-enlace"
          href="/solicitudes/nueva?habitacionId=<%= habitacion.id %>"
        >Solicitar reserva</a>
      </li>
      <% }) %>
    </ul>
  </li>
  <% }) %>
</ul>
<% } %>
